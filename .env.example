# BrainBuddy Environment Variables
# =================================

# Supabase Configuration
# =====================
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anonymous/public key
VITE_SUPABASE_ANON_KEY=

# =================================
# IMPORTANT: Do NOT commit this file
# =================================

# If these are not set, the app runs in DEMO MODE:
# - All data is stored locally in your browser
# - No cloud sync occurs
# - Perfect for development and testing

# To enable cloud features:
# 1. Create a Supabase project at https://supabase.com
# 2. Copy your project URL and anon key
# 3. Create a .env file (not .env.example) with your values
# 4. Restart the dev server
